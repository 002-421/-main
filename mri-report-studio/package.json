{
  "name": "mri-report-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Локальный редактор протоколов МРТ с модулями и экспортом PDF",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "desktop:install": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "package:windows": "python3 scripts/package_windows.py"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "dompurify": "^3.3.1",
    "lucide": "^0.575.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.0",
    "@types/node": "^24.10.0"
  },
  "type": "module"
}
