{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "catalogId",
    "catalogVersion",
    "sequence",
    "channel",
    "minimumXrsVersion",
    "publishedAt",
    "expiresAt",
    "publisher",
    "packages"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "type": {
      "const": "xrs-template-catalog"
    },
    "catalogId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "channel": {
      "enum": [
        "stable",
        "test"
      ]
    },
    "minimumXrsVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "keyId"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "keyId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "packages": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateId",
          "templateVersion",
          "action",
          "url",
          "sha256",
          "size",
          "summary"
        ],
        "properties": {
          "templateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          },
          "templateVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
          },
          "action": {
            "enum": [
              "add",
              "update",
              "remove"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          }
        }
      }
    },
    "revisions": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "templateId",
          "templateVersion",
          "action",
          "url",
          "sha256",
          "size",
          "summary",
          "status",
          "publishedAt",
          "approvedBy"
        ],
        "properties": {
          "templateId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
          },
          "templateVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
          },
          "action": {
            "enum": [
              "add",
              "update",
              "remove"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8388608
          },
          "summary": {
            "type": "string",
            "maxLength": 2000
          },
          "status": {
            "enum": [
              "Active",
              "Archived",
              "Revoked"
            ]
          },
          "publishedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
          },
          "approvedBy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "revisions"
        ],
        "properties": {
          "revisions": {}
        }
      },
      "else": {
        "not": {
          "required": [
            "revisions"
          ],
          "properties": {
            "revisions": {}
          }
        }
      }
    }
  ]
}
