{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "areaId",
    "areaTitle",
    "modality",
    "templateVersion",
    "minimumXrsVersion",
    "doc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "areaId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "areaTitle": {
      "type": "string",
      "maxLength": 200
    },
    "modality": {
      "enum": [
        "MRI",
        "CT"
      ]
    },
    "templateVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "minimumXrsVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "doc": {
      "$ref": "#/$defs/node"
    },
    "retired": {
      "type": "boolean"
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "doc",
            "paragraph",
            "heading",
            "text",
            "horizontalRule",
            "hardBreak",
            "table",
            "tableRow",
            "tableCell",
            "tableHeader",
            "image",
            "reportField",
            "reportSection",
            "blockquote",
            "bulletList",
            "orderedList",
            "listItem"
          ]
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        },
        "attrs": {
          "type": "object"
        },
        "marks": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "bold",
                  "italic",
                  "underline",
                  "strike",
                  "subscript",
                  "superscript",
                  "textStyle",
                  "templateField",
                  "templateHighlight",
                  "templateSize",
                  "highlight"
                ]
              },
              "attrs": {
                "type": "object"
              }
            }
          }
        },
        "content": {
          "type": "array",
          "maxItems": 30000,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    }
  }
}
