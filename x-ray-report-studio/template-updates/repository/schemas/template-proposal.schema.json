{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "template-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "baseVersion",
    "baseSha256",
    "template",
    "summary",
    "medicalApproval",
    "channel"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "const": "xrs-template-proposal"
    },
    "baseVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"
    },
    "baseSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "template": {
      "$ref": "template.schema.json"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "medicalApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "reference"
      ],
      "properties": {
        "approved": {
          "const": true
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "channel": {
      "enum": [
        "stable",
        "test"
      ]
    }
  }
}
