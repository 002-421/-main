{
  "name": "x-ray-report-studio",
  "version": "0.4.55-beta.1",
  "private": true,
  "description": "X-ray Report Studio: локальный редактор протоколов МРТ и КТ с шаблонами, проверкой русского текста, DOCX и PDF",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "desktop:install": "node node_modules/electron/install.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:undo-scroll": "node tests/undo-scroll-browser.mjs",
    "test:history-browser": "node tests/report-history-browser.mjs",
    "test:history-benchmark": "node --expose-gc tests/report-history-benchmark.mjs",
    "test:tab-isolation": "node tests/tab-isolation-browser.mjs",
    "test:tab-lifecycle": "node tests/report-tab-lifecycle-browser.mjs",
    "test:workspace-recovery": "node tests/workspace-recovery-browser.mjs",
    "test:windows-integration": "node --test tests/windows-integration.test.mjs",
    "test:updater-0.4.54-e2e": "node tests/updater-0.4.54-e2e.mjs",
    "test:preupdate-backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/XRS-PreUpdate-Backup.Tests.ps1",
    "test:preupdate-backup-core": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/XRS-PreUpdate-Backup.Tests.ps1 -TestGroup Core",
    "test:preupdate-backup-cli-success": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/XRS-PreUpdate-Backup.Tests.ps1 -TestGroup CliSuccess",
    "test:preupdate-backup-cli-failure-exit": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/XRS-PreUpdate-Backup.Tests.ps1 -TestGroup CliFailureExit",
    "test:preupdate-backup-cli-failure-output": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/XRS-PreUpdate-Backup.Tests.ps1 -TestGroup CliFailureOutput",
    "test:preupdate-backup-cli-cleanup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tests/XRS-PreUpdate-Backup.Tests.ps1 -TestGroup CliCleanup",
    "package:windows": "python3 scripts/package_windows.py",
    "package:windows-test-kit": "python3 scripts/package_test_kit.py",
    "package:setup": "python3 scripts/package_setup.py",
    "test:morphology-browser": "node tests/morphology-browser.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "az": "0.2.3",
    "dictionary-en": "4.0.0",
    "dictionary-ru": "^3.0.0",
    "docx": "^9.14.0",
    "dompurify": "^3.3.1",
    "fflate": "^0.8.3",
    "lucide": "^0.575.0",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "electron": "45.0.0",
    "playwright-core": "1.64.1",
    "rcedit": "^5.0.2",
    "resedit": "^3.1.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "type": "module"
}
